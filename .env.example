# Saved towns on Vercel (and anywhere that is not Cloudflare).
# Create a database at https://turso.tech, then:
#   node scripts/migrate-turso.mjs
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token

# Cloudflare/OpenAI Sites needs neither: the D1 binding named in
# .openai/hosting.json is used automatically.

# One shared secret for the two things only you should do, until real accounts
# exist: reading player feedback (GET /api/feedback?key=<this>) and taking a
# town out of the public gallery (/api/admin/towns?key=<this>).
# Must be at least 16 characters. Leave it unset and both refuse everyone,
# including you — which is the safe way round.
ADMIN_KEY=pick-a-long-random-string
